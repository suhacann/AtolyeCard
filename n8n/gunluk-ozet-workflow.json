    {
      "id": "b1a1c001-0000-4000-8000-000000000005",
      "name": "Ürüne göre grupla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "jsCode": "// Özet gününün siparişlerini ürün koduna göre gruplar: ürün başına sipariş sayısı, toplam adet ve tutar.\n// Fiyatlar src/data/products.js ile elle senkron; fiyat değişirse burayı da güncelleyin.\nconst PRICE_BY_PRODUCT = {\n  'hus-kuksa': 1450,\n  'ceviz-yemek-kasigi': 380,\n  'kiraz-olcu-kasigi': 290,\n}\n\nconst ozetGunu = $('Özet günü').first().json.ozetGunu\n\n// 'Tarih' sütunu \"08.11.2026 19:45:12\" ya da \"8.11.2026 ...\" gelebilir: gün/ay/yılı sayı olarak karşılaştır.\nconst dayKey = (text) => {\n  const m = String(text ?? '').match(/(\\d{1,2})[./](\\d{1,2})[./](\\d{4})/)\n  return m ? `${Number(m[1])}.${Number(m[2])}.${m[3]}` : null\n}\nconst target = dayKey(ozetGunu)\n\nconst groups = new Map()\nfor (const { json: row } of $input.all()) {\n  if (!row['Ürün Kodu'] || dayKey(row['Tarih']) !== target) continue\n  const code = row['Ürün Kodu']\n  const g = groups.get(code) ?? { name: row['Ürün'], orders: 0, quantity: 0 }\n  g.orders += 1\n  g.quantity += Number(row['Adet']) || 1\n  groups.set(code, g)\n}\n\nif (groups.size === 0) {\n  return [{ json: { mesaj: `${ozetGunu} için sipariş yok` } }]\n}\n\nreturn [...groups.entries()]\n  .sort((a, b) => b[1].quantity - a[1].quantity)\n  .map(([code, g]) => {\n    const price = PRICE_BY_PRODUCT[code]\n    return {\n      json: {\n        'Tarih': ozetGunu,\n        'Ürün Kodu': code,\n        'Ürün': g.name,\n        'Sipariş Sayısı': g.orders,\n        'Toplam Adet': g.quantity,\n        // Bilinmeyen ürün kodunda tutar boş kalır; uydurma fiyat yazmıyoruz.\n        'Tutar (₺)': price === undefined ? '' : price * g.quantity,\n      },\n    }\n  })\n"
      }
    },
