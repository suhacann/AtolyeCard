    {
      "id": "b1a1c001-0000-4000-8000-000000000009",
      "name": "Günün özeti",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        -120
      ],
      "parameters": {
        "jsCode": "// Döngü bitince tüm ürün satırlarından tek bir okunur özet kurar.\nconst rows = $('Ürüne göre grupla').all().map((i) => i.json)\nconst tl = (n) => `${n.toLocaleString('tr-TR')} ₺`\n\nconst siparisSayisi = rows.reduce((s, r) => s + r['Sipariş Sayısı'], 0)\nconst toplamAdet = rows.reduce((s, r) => s + r['Toplam Adet'], 0)\nconst toplamTutar = rows.reduce((s, r) => s + (Number(r['Tutar (₺)']) || 0), 0)\n\nconst satirlar = rows.map(\n  (r) => `- ${r['Ürün']}: ${r['Toplam Adet']} adet (${r['Sipariş Sayısı']} sipariş)` +\n    (r['Tutar (₺)'] === '' ? ', fiyat bilinmiyor' : `, ${tl(r['Tutar (₺)'])}`),\n)\n\nreturn [{\n  json: {\n    ozetGunu: rows[0]['Tarih'],\n    siparisSayisi,\n    toplamAdet,\n    toplamTutar,\n    metin: [`${rows[0]['Tarih']} sipariş özeti`, ...satirlar, `Toplam: ${siparisSayisi} sipariş, ${toplamAdet} adet, ${tl(toplamTutar)}`].join('\\n'),\n  },\n}]\n"
      }
    },
