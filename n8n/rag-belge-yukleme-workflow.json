{
  "id": "atolyeKartRag001",
  "name": "AtölyeKart — RAG belge yükleme (Qdrant)",
  "nodes": [
    {
      "id": "c5100001-0000-4000-8000-000000000001",
      "name": "Belge yükleme formu",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.4,
      "position": [
        0,
        300
      ],
      "parameters": {
        "formTitle": "AtölyeKart — SSS belgesi yükle",
        "formDescription": "Chatbotun cevap verirken kullandığı belgeler. Aynı belge türü yeniden yüklenirse eski sürümün parçaları silinir, yenisi eklenir.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Dosya (.docx ya da .pdf)",
              "fieldName": "dosya",
              "fieldType": "file",
              "acceptFileTypes": ".docx,.pdf",
              "multipleFiles": false,
              "requiredField": true
            },
            {
              "fieldLabel": "Belge",
              "fieldName": "belge",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "bakim-rehberi"
                  },
                  {
                    "option": "siparis-sss"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Sürüm",
              "fieldName": "versiyon",
              "fieldType": "number",
              "defaultValue": "1",
              "requiredField": true
            },
            {
              "fieldLabel": "Chunk boyutu (karakter)",
              "fieldName": "chunkBoyutu",
              "fieldType": "number",
              "defaultValue": "500",
              "requiredField": true
            },
            {
              "fieldLabel": "Chunk örtüşmesi (karakter)",
              "fieldName": "chunkOrtusme",
              "fieldType": "number",
              "defaultValue": "50",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "path": "atolyekart-belge",
          "buttonLabel": "Yükle",
          "appendAttribution": false
        }
      },
      "webhookId": "5b1c2f0e-6a44-4c3e-9d1a-0a7e5b3c9f01"
    },
    {
      "id": "c5100001-0000-4000-8000-000000000002",
      "name": "Eski parçaları sil",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "// Aynı belge türünün eski parçalarını Qdrant'tan siler; böylece yeni sürüm eskisinin yerine geçer.\nconst QDRANT = 'http://host.docker.internal:6333/collections/atolyekart_sss';\nconst belge = $input.first().json.belge;\nconst filter = { must: [{ key: 'metadata.belge', match: { value: belge } }] };\n\nlet silinenParca = 0;\nconst { result } = await this.helpers.httpRequest({ method: 'GET', url: `${QDRANT}/exists`, json: true });\nif (result.exists) {\n  const count = await this.helpers.httpRequest({ method: 'POST', url: `${QDRANT}/points/count`, body: { filter, exact: true }, json: true });\n  silinenParca = count.result.count;\n  await this.helpers.httpRequest({ method: 'POST', url: `${QDRANT}/points/delete?wait=true`, body: { filter }, json: true });\n}\n\nreturn $input.all().map((item) => ({ json: { ...item.json, silinenParca }, binary: item.binary }));\n"
      }
    },
    {
      "id": "c5100001-0000-4000-8000-000000000003",
      "name": "Qdrant'a yaz",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.3,
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "insert",
        "qdrantCollection": {
          "__rl": true,
          "mode": "id",
          "value": "atolyekart_sss"
        },
        "embeddingBatchSize": 100,
        "options": {}
      }
    },
    {
      "id": "c5100001-0000-4000-8000-000000000004",
      "name": "Gemini embedding",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [
        400,
        520
      ],
      "parameters": {
        "modelName": "models/gemini-embedding-001"
      }
    },
    {
      "id": "c5100001-0000-4000-8000-000000000005",
      "name": "Belge okuyucu",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        600,
        520
      ],
      "parameters": {
        "dataType": "binary",
        "binaryMode": "allInputData",
        "loader": "auto",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "belge",
                "value": "={{ $json.belge }}"
              },
              {
                "name": "versiyon",
                "value": "={{ String($json.versiyon) }}"
              },
              {
                "name": "chunkBoyutu",
                "value": "={{ String($json.chunkBoyutu) }}"
              },
              {
                "name": "yuklenmeTarihi",
                "value": "={{ $now.toFormat('yyyy-MM-dd HH:mm') }}"
              }
            ]
          }
        }
      }
    },
    {
      "id": "c5100001-0000-4000-8000-000000000006",
      "name": "Parçalayıcı",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        680,
        720
      ],
      "parameters": {
        "chunkSize": "={{ $json.chunkBoyutu }}",
        "chunkOverlap": "={{ $json.chunkOrtusme }}",
        "options": {}
      }
    },
    {
      "id": "c5100001-0000-4000-8000-000000000007",
      "name": "Yükleme özeti",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        300
      ],
      "parameters": {
        "jsCode": "const form = $('Eski parçaları sil').first().json;\nreturn [{\n  json: {\n    belge: form.belge,\n    versiyon: form.versiyon,\n    chunkBoyutu: form.chunkBoyutu,\n    silinenParca: form.silinenParca,\n    eklenenParca: $input.all().length,\n  },\n}];\n"
      }
    }
  ],
  "connections": {
    "Belge yükleme formu": {
      "main": [
        [
          {
            "node": "Eski parçaları sil",
