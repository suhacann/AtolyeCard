    {
      "id": "c6100001-0000-4000-8000-000000000003",
      "name": "Workflow listesini al (n8n API)",
      "type": "n8n-nodes-base.n8n",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "resource": "workflow",
        "operation": "getAll",
        "returnAll": true,
        "filters": {
          "excludePinnedData": true
        },
        "requestOptions": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "c6100001-0000-4000-8000-000000000004",
      "name": "Yedek dosyası",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "// Tüm workflow'ları tek bir JSON yedek dosyasına toplar.\n// Credential gizli değerleri workflow'da durmaz (yalnızca adı/kimliği); pinned data hariç.\nconst workflows = $input.all().map((i) => i.json);\nconst simdi = new Date();\nconst tarih = simdi.toLocaleString('sv-SE', { timeZone: 'Europe/Istanbul' }).slice(0, 16).replace(' ', '_').replace(':', '-');\nconst yedek = {\n  yedekTarihi: simdi.toISOString(),\n  kaynak: 'AtölyeKart n8n (yerel)',\n  workflowSayisi: workflows.length,\n  workflows: workflows\n    .map((w) => ({ id: w.id, name: w.name, active: w.active, updatedAt: w.updatedAt, settings: w.settings, nodes: w.nodes, connections: w.connections }))\n    .sort((a, b) => a.name.localeCompare(b.name, 'tr')),\n};\nconst dosyaAdi = `atolyekart-n8n-yedek_${tarih}.json`;\nconst binary = await this.helpers.prepareBinaryData(Buffer.from(JSON.stringify(yedek, null, 2), 'utf8'), dosyaAdi, 'application/json');\nreturn [{ json: { dosyaAdi, workflowSayisi: workflows.length, isimler: yedek.workflows.map((w) => w.name) }, binary: { data: binary } }];\n"
      }
    },
    {
      "id": "c6100001-0000-4000-8000-000000000005",
      "name": "Drive'a yükle",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        720,
        300
      ],
      "parameters": {
        "name": "={{ $json.dosyaAdi }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "list",
          "value": "root",
          "cachedResultName": "/ (Root folder)"
        },
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "c6100001-0000-4000-8000-000000000006",
      "name": "Yedek özeti",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst y = $('Yedek dosyası').first().json;\nreturn [{ json: { durum: 'yedeklendi', dosya: y.dosyaAdi, workflowSayisi: y.workflowSayisi, driveId: d.id, driveLink: d.webViewLink ?? null } }];\n"
      }
    }
  ],
