      "webhookId": "5b9e2f4a-7c1d-4e8b-9f3a-atolyekart01"
    },
    {
      "parameters": {
        "jsCode": "// Webhook gövdesinden tablo satırını kurar ve tahmini hazırlanma süresini hesaplar.\n// Süre kuralla hesaplanır, AI'a hazır verilir: modelin kendi kafasından teslim sözü vermesini istemiyoruz.\n// Kategori, Ortak doğrulama sub-workflow'undan gelir (katalog orada).\n// İş günü: ilk ürün için taban süre, her ek adet için ek süre.\nconst PREP_RULES = {\n  kuksa: { base: 5, perExtra: 2 },\n  kasik: { base: 3, perExtra: 1 },\n}\nconst DEFAULT_RULE = { base: 5, perExtra: 2 }\nconst MAX_DAYS = 21\n\nreturn $input.all().map(item => {\n  const order = item.json\n  const quantity = Number(order.quantity) || 1\n  const rule = PREP_RULES[order.category] || DEFAULT_RULE\n  const prepDays = Math.min(MAX_DAYS, rule.base + rule.perExtra * (quantity - 1))\n\n  return {\n    json: {\n      'Tarih': new Date().toLocaleString('tr-TR', { timeZone: 'Europe/Istanbul' }),\n      'Ad': order.name,\n      'Ürün Kodu': order.productId,\n      'Ürün': order.productName,\n      'Adet': quantity,\n      'Telefon': order.phone,\n      'E-posta': order.email,\n      'Hazırlanma (iş günü)': prepDays,\n    },\n  }\n})\n"
      },
      "id": "2cbadc28-0511-4283-b325-62c5c664cd81",
      "name": "Sipariş satırı",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -112
      ]
    },
